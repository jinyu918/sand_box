{
  "name": "cove-sandbox",
  "version": "0.1.0",
  "description": "Security-first desktop sandbox for AI coding agents",
  "type": "module",
  "license": "MIT",
  "bin": {
    "cove": "dist/cli.js"
  },
  "files": [
    "dist",
    "docker",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-broker.mjs && node scripts/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dns-packet": "^5.6.1",
    "node-forge": "^1.4.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^22.19.0",
    "@types/node-forge": "^1.3.14",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
